---
// Landing hero — Apple-style centered composition: eyebrow, large headline,
// subhead, CTAs, then a quiet full-width stat strip. Soft accent glow ground.
const heroBg =
  'background:radial-gradient(1200px 720px at 50% -24%, color-mix(in srgb, var(--color-accent) 15%, transparent), transparent 60%), radial-gradient(900px 520px at 86% 6%, color-mix(in srgb, var(--color-accent-2) 8%, transparent), transparent 62%), var(--color-bg)';

const specs = [
  { title: 'Более 10 лет', sub: 'на рынке корпоративных перевозок' },
  { title: '150+ сотрудников', sub: 'водители, логисты, диспетчеры, механики в штате' },
  { title: 'Тысячи маршрутов', sub: 'выполняются ежедневно по всей стране' },
  { title: 'Вся Россия', sub: 'Москва, область и крупнейшие города страны' },
];
---
<section class="relative border-b border-divider overflow-hidden" style={heroBg}>
  <div class="max-w-container mx-auto px-[clamp(20px,4vw,56px)] pt-[clamp(76px,11vw,152px)] pb-[clamp(56px,7vw,104px)] flex flex-col items-center text-center">
    <div class="font-heading text-[13px] tracking-[0.14em] uppercase text-accent-700 mb-6">Корпоративный транспорт · Москва и регионы России</div>
    <h1 class="text-[clamp(44px,6.6vw,88px)] leading-[1.02] tracking-[-0.03em] font-heading m-0 max-w-[15ch] [text-wrap:balance]">Транспортное обслуживание бизнеса под ключ</h1>
    <p class="mt-7 text-[clamp(17px,1.5vw,21px)] leading-[1.55] max-w-[58ch] text-text/[0.72] [text-wrap:pretty]">Автомобили с водителями, корпоративное такси, доставка корреспонденции и собственная TMS-платформа для контроля поездок и расходов. Договор, закрывающие документы и безналичный расчёт.</p>
    <div class="mt-9 flex gap-3 flex-wrap justify-center">
      <a class="btn btn-primary min-h-[54px] px-[30px] text-[15px]" href="https://t.me/otktrans" target="_blank" rel="noopener">Написать в Telegram</a>
      <a class="btn btn-secondary min-h-[54px] px-[30px] text-[15px]" href="tel:+74957874095">Позвонить</a>
    </div>
    <p class="mt-6 text-sm text-text/[0.55] max-w-[54ch]">Отвечаем в течение 15 минут в рабочее время. Расчёт по вашей маршрутной программе — за один день.</p>
  </div>

  <div class="relative border-t border-divider">
    <div class="max-w-container mx-auto px-[clamp(20px,4vw,56px)] py-[clamp(32px,3.4vw,52px)] grid grid-cols-2 lg:grid-cols-4 gap-y-9 gap-x-6">
      {specs.map((s, i) => (
        <div class={`text-center px-2 ${i > 0 ? 'lg:border-l lg:border-divider' : ''}`}>
          <div class="font-heading text-[clamp(26px,2.6vw,36px)] leading-[1.05]">{s.title}</div>
          <div class="text-sm text-text/[0.6] mt-2 max-w-[26ch] mx-auto">{s.sub}</div>
        </div>
      ))}
    </div>
  </div>
</section>
