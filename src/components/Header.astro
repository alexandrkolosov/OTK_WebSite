---
import Logo from './Logo.astro';

interface Props {
  active?: 'services' | 'fleet' | 'cases' | 'about' | 'blog' | 'contacts' | 'home';
}
const { active = 'home' } = Astro.props;

const links = [
  { href: '/uslugi/', label: 'Услуги', key: 'services' },
  { href: '/avtopark/', label: 'Автопарк', key: 'fleet' },
  { href: '/keysy/', label: 'Кейсы', key: 'cases' },
  { href: '/o-kompanii/', label: 'О компании', key: 'about' },
  { href: '/blog/', label: 'Блог', key: 'blog' },
  { href: '/kontakty/', label: 'Контакты', key: 'contacts' },
];
---
<header class="sticky top-0 z-[60] bg-bg/90 backdrop-blur-[10px] border-b border-divider">
  <div class="max-w-container mx-auto px-[clamp(20px,4vw,56px)] py-4 min-h-[82px] flex items-center gap-[clamp(14px,2.4vw,34px)] flex-wrap">
    <a href="/" aria-label="ОТК — на главную" class="flex items-center leading-[0]">
      <Logo variant="header" width={100} height={30} />
    </a>
    <nav aria-label="Основная навигация" class="flex items-center gap-[clamp(12px,1.7vw,26px)] flex-wrap mr-auto">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={active === l.key ? 'page' : undefined}
          class="font-heading font-semibold text-sm tracking-[0.07em] uppercase text-text no-underline hover:text-accent aria-[current=page]:text-accent"
        >{l.label}</a>
      ))}
    </nav>
    <a href="tel:+74957874095" class="font-heading font-semibold text-[17px] tracking-[0.02em] text-text no-underline whitespace-nowrap">+7 (495) 787-40-95</a>
    <a
      class="btn btn-primary blueprint min-h-[44px] px-[18px] tracking-[0.06em] uppercase whitespace-nowrap"
      href="https://t.me/otktrans"
      target="_blank"
      rel="noopener"
    >
      Написать в Telegram
      <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
    </a>
  </div>
</header>
