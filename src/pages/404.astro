---
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  { href: '/uslugi/', label: 'Услуги' },
  { href: '/avtopark/', label: 'Автопарк' },
  { href: '/keysy/', label: 'Кейсы' },
  { href: '/blog/', label: 'Блог' },
  { href: '/kontakty/', label: 'Контакты' },
];
---
<BaseLayout
  title="Страница не найдена — ОТК"
  description="Запрошенная страница не найдена. Вернитесь на главную или воспользуйтесь навигацией по разделам сайта ОТК."
  path="/404/"
  noindex={true}
>
  <section class="border-b border-divider">
    <div class="max-w-container mx-auto px-[clamp(20px,4vw,56px)] py-[clamp(72px,10vw,140px)] flex flex-col items-start gap-6">
      <div class="font-heading text-[clamp(80px,16vw,180px)] leading-none text-accent-300">404</div>
      <h1 class="text-[clamp(28px,3.4vw,46px)] tracking-[-0.015em] m-0 max-w-[20ch]">Страница не найдена</h1>
      <p class="m-0 text-[17px] leading-[1.6] max-w-[52ch] text-text/[0.78]">Возможно, ссылка устарела или содержит опечатку. Вернитесь на главную или перейдите в один из разделов.</p>
      <div class="flex gap-3 flex-wrap mt-2">
        <a class="btn btn-primary min-h-[52px] px-[26px] tracking-[0.07em]" href="/">На главную</a>
        <a class="btn btn-secondary min-h-[52px] px-[26px] tracking-[0.07em]" href="/kontakty/">Связаться с нами</a>
      </div>
      <nav class="flex gap-5 flex-wrap mt-4 pt-6 border-t border-divider w-full">
        {links.map((l) => (
          <a href={l.href} class="font-heading text-sm tracking-[0.06em] text-accent-700 no-underline hover:text-accent">{l.label}</a>
        ))}
      </nav>
    </div>
  </section>
</BaseLayout>
