---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../lib/services';

const origin = 'https://otktrans.ru';

const priceRows = [
  ['Класс автомобиля', 'от комфорта до представительского', 'основной фактор'],
  ['Продолжительность смены', '8 / 10 / 12 / 24 часа', 'прямая зависимость'],
  ['Количество автомобилей', 'парк от 1 до нескольких десятков', 'объёмная скидка'],
  ['Срок договора', '12, 24, 36 месяцев и более', 'фиксация ставки'],
  ['География', 'Москва, область, другие регионы', 'надбавка за межгород'],
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Услуги корпоративного транспорта ОТК',
  itemListElement: services.map((s, i) => ({
    '@type': 'Service',
    position: i + 1,
    name: s.name,
    serviceType: s.serviceType,
    areaServed: 'Москва и Россия',
    provider: { '@type': 'Organization', name: 'ОТК' },
    url: `${origin}/uslugi/${s.slug}/`,
  })),
});
---
<BaseLayout
  title="Услуги ОТК: аренда авто с водителем, поездки по заявке, TMS — Москва"
  description="Услуги корпоративного транспорта ОТК: аренда автомобиля с водителем, аренда авто с экипажем по заявке, обслуживание первых лиц, перевозка корреспонденции, TMS-платформа управления автопарком. Безналичный расчёт, договор от 12 месяцев."
  path="/uslugi/"
  active="services"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="border-b border-divider" style="background:radial-gradient(1100px 520px at 88% -12%, color-mix(in srgb, var(--color-accent) 16%, transparent), transparent 68%), radial-gradient(760px 420px at 4% 8%, color-mix(in srgb, var(--color-accent-2) 10%, transparent), transparent 66%), var(--color-bg)">
    <div class="max-w-container mx-auto py-[clamp(88px,10vw,148px)] px-[clamp(20px,4vw,56px)]">
      <div class="font-heading text-[12px] tracking-[0.14em] uppercase text-accent-700 mb-4">Услуги</div>
      <h1 class="text-[length:var(--fs-h1)] leading-[1.02] tracking-[-0.02em] m-0 mb-5 max-w-[18ch]">Транспортные услуги для юридических лиц</h1>
      <p class="text-[length:var(--fs-lead)] leading-[1.6] max-w-[62ch] text-text/[0.78] m-0">Пять форматов обслуживания, которые собираются в одну маршрутную программу и один договор. Выберите услугу — на странице описано, что входит, как считается стоимость и какие документы вы получаете.</p>
    </div>
  </section>

  <!-- Карточки услуг -->
  <section class="border-b border-divider">
    <div class="max-w-container mx-auto py-[clamp(72px,9vw,140px)] px-[clamp(20px,4vw,56px)]">
      <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-[clamp(18px,2vw,28px)]">
        {services.map((s, i) => (
          <a href={`/uslugi/${s.slug}/`} class="blueprint p-[clamp(28px,3vw,40px)] flex flex-col no-underline text-text hover:border-accent transition-colors">
            <span class="font-heading text-[12px] tracking-[0.14em] uppercase text-accent-700">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="text-[clamp(21px,2.2vw,27px)] leading-[1.15] tracking-[-0.01em] mt-3 mb-2.5">{s.name}</h2>
            <p class="text-[14px] leading-[1.6] text-text/[0.72] m-0 flex-1">{s.short}</p>
            <span class="font-heading text-[14px] text-accent mt-5 inline-flex items-center gap-1.5">Подробнее <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Как формируется стоимость -->
  <section class="border-b border-divider">
    <div class="max-w-container mx-auto py-[clamp(80px,10vw,150px)] px-[clamp(20px,4vw,56px)]">
      <h2 class="text-[length:var(--fs-h2)] tracking-[-0.015em] m-0 mb-5">Как формируется стоимость</h2>
      <div class="blueprint p-[clamp(24px,2.6vw,34px)]">
        <div class="overflow-x-auto"><table class="table min-w-[440px]">
          <thead><tr><th>Параметр</th><th>Что учитывается</th><th>Влияние на цену</th></tr></thead>
          <tbody>
            {priceRows.map(([param, what, impact]) => (
              <tr><td>{param}</td><td>{what}</td><td>{impact}</td></tr>
            ))}
          </tbody>
        </table></div>
      </div>
      <p class="mt-[18px] mb-0 text-[14px] text-text/[0.72]">Точную ставку считаем по вашей маршрутной программе. Пришлите список маршрутов — вернёмся с расчётом за один рабочий день.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-accent-900 text-[#f2f2f3]">
    <div class="max-w-container mx-auto py-[clamp(92px,11vw,160px)] px-[clamp(20px,4vw,56px)] grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-[clamp(34px,3.8vw,68px)] items-center">
      <h2 class="text-[length:var(--fs-h2)] tracking-[-0.015em] m-0 max-w-[18ch]">Соберём обслуживание под вашу задачу</h2>
      <div class="flex gap-3 flex-wrap">
        <a class="btn btn-onlight min-h-[52px] px-[26px] tracking-[0.07em]" href="https://t.me/otktrans" target="_blank" rel="noopener">Telegram</a>
        <a class="btn btn-ondark min-h-[52px] px-[26px] tracking-[0.07em]" href="tel:+74957874095">Позвонить</a>
        <a class="btn btn-ondark min-h-[52px] px-[26px] tracking-[0.07em]" href="/kontakty/">Форма на сайте</a>
      </div>
    </div>
  </section>
</BaseLayout>
