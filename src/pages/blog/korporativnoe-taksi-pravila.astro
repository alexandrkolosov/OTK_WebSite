---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { img } from '../../lib/img';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Корпоративные поездки сотрудников: правила, лимиты и контроль перерасхода',
  description: 'Как описать политику корпоративных поездок, чтобы ей пользовались сотрудники, а расходы оставались прозрачными.',
  author: { '@type': 'Organization', name: 'ОТК' },
  publisher: { '@type': 'Organization', name: 'ОТК' },
  mainEntityOfPage: 'https://otktrans.ru/blog/korporativnoe-taksi-pravila/',
  inLanguage: 'ru-RU',
});

const scenarioRows = [
  ['Встреча с клиентом в рабочее время', 'не требуется', 'комфорт'],
  ['Поездка между офисами компании', 'не требуется', 'эконом / комфорт'],
  ['Аэропорт, командировка', 'руководитель', 'комфорт'],
  ['Работа позже 22:00', 'не требуется', 'эконом / комфорт'],
  ['Приём гостей компании', 'руководитель', 'бизнес / представительский'],
  ['Прочие поездки', 'руководитель + администрация', 'по согласованию'],
];

const reporting = [
  'Детализация: сотрудник, дата, маршрут, длительность, стоимость',
  'Разбивка по подразделениям и центрам затрат',
  'Сравнение с предыдущим периодом и с лимитом',
  'Топ-10 самых дорогих поездок месяца',
  'Закрывающие документы одним пакетом',
];
---
<ArticleLayout
  pageTitle="Корпоративные поездки сотрудников: правила, лимиты и контроль перерасхода — ОТК"
  description="Как составить политику корпоративных поездок: кто и когда может заказывать поездку, лимиты по подразделениям, согласование, центры затрат и отчётность. Шаблон правил на одну страницу."
  path="/blog/korporativnoe-taksi-pravila/"
  heading="Корпоративные поездки сотрудников: правила, лимиты и контроль перерасхода"
  category="Организация"
  lead="Короткий ответ: рабочая политика поездок умещается на одну страницу и отвечает на четыре вопроса — кто может заказывать, в каких случаях, до какой суммы и что происходит при превышении. Всё, что длиннее, сотрудники не читают, а служба поддержки трактует по-своему."
  meta="Материал ОТК · 5 минут чтения"
  heroImg={img('/img/1611448746128-7c39e03b71e4.jpg')}
  heroAlt="Поездка по городу: вид с водительского места"
  jsonLd={jsonLd}
>
  <h2>Кто может заказывать</h2>
  <p>Самый простой рабочий вариант — три группы доступа: сотрудники без ограничений по служебной необходимости (руководители), сотрудники с согласованием руководителя и сотрудники, которым поездки заказывает координатор. Открытый доступ всем без исключения почти всегда приводит к росту расходов на 30–40% в первые два месяца.</p>

  <h2>В каких случаях поездка оправдана</h2>
  <p>Перечислите сценарии явно: встречи с клиентами и партнёрами, перемещения между офисами, поездки в аэропорт и на вокзал в командировку, работа после 22:00, перевозка оборудования или документов. Всё, что не попадает в список, требует согласования — так вы избегаете спорных ситуаций без запретительного тона.</p>

  <div class="blueprint p-[clamp(24px,2.6vw,34px)] my-6">
    <div class="overflow-x-auto"><table class="table min-w-[440px]">
      <thead><tr><th>Сценарий</th><th>Кто согласует</th><th>Класс автомобиля</th></tr></thead>
      <tbody>
        {scenarioRows.map((r) => (<tr><td>{r[0]}</td><td>{r[1]}</td><td>{r[2]}</td></tr>))}
      </tbody>
    </table></div>
  </div>

  <h2>Лимиты: по сотруднику или по подразделению</h2>
  <p>Лимит на сотрудника проще администрировать, но плохо работает там, где нагрузка неравномерна. Лимит на подразделение с ответственным руководителем гибче: внутри отдела бюджет распределяется по фактической потребности. Оптимально сочетать: месячный лимит подразделения и потолок стоимости одной поездки.</p>

  <h2>Что делать с перерасходом</h2>
  <p>Жёсткая блокировка заказов в конце месяца парализует работу. Практичнее мягкий контроль: уведомление руководителю при достижении 80% лимита, обязательное согласование сверх лимита и разбор структуры расходов на ежемесячной встрече. Как правило, после первого же разбора расходы возвращаются к норме.</p>

  <h2>Отчётность, которая нужна финансовому департаменту</h2>
  <ul>
    {reporting.map((item) => (<li>{item}</li>))}
  </ul>
  <p>Если подрядчик не даёт такую выгрузку, контроль расходов превращается в ручную работу бухгалтерии — этот вопрос стоит закрыть ещё на этапе переговоров.</p>

  <div class="blueprint p-[clamp(30px,3vw,42px)] mt-9" style="background:color-mix(in srgb, var(--color-accent) 6%, var(--color-bg))">
    <h2 class="text-[26px] mt-0 mb-2.5">Настроим правила вместе с вами</h2>
    <p class="m-0 mb-[18px] text-[15px] leading-[1.65] text-text/[0.78]">В сервисе поездок по заявке ОТК лимиты, согласования и центры затрат настраиваются в платформе, а отчёт приходит в конце месяца одним файлом.</p>
    <div class="flex gap-3 flex-wrap">
      <a class="btn btn-primary min-h-[48px] tracking-[0.06em]" href="https://t.me/otktrans" target="_blank" rel="noopener">Написать в Telegram</a>
      <a class="btn btn-secondary min-h-[48px] tracking-[0.06em]" href="/uslugi/arenda-avto-s-ekipazhem/">Об услуге</a>
    </div>
  </div>
</ArticleLayout>
