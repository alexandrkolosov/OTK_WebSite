---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { img } from '../../lib/img';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Как ГЛОНАСС-мониторинг снижает транспортные расходы',
  description: 'Какие данные даёт система мониторинга и как компании используют их для сокращения транспортного бюджета.',
  author: { '@type': 'Organization', name: 'ОТК' },
  publisher: { '@type': 'Organization', name: 'ОТК' },
  mainEntityOfPage: 'https://otktrans.ru/blog/glonass-monitoring-rashody/',
  inLanguage: 'ru-RU',
});

const dataRows = [
  ['Пересекающиеся маршруты', 'объединение рейсов', 'минус 1–2 автомобиля'],
  ['Долгие простои в середине дня', 'смена формата на почасовой', 'минус 15–25% часов'],
  ['Поездки вне маршрутной программы', 'правила и согласование', 'минус нецелевые расходы'],
  ['Систематические опоздания подачи', 'сдвиг расписания', 'меньше переработок'],
  ['Перепробег относительно оптимального маршрута', 'перестроение логистики', 'экономия топлива и часов'],
];
---
<ArticleLayout
  pageTitle="Как ГЛОНАСС-мониторинг снижает транспортные расходы компании — ОТК"
  description="Что видно в данных ГЛОНАСС-мониторинга: холостые пробеги, простои, отклонения от маршрута и нецелевые поездки. Как на этих данных компании сокращают транспортный бюджет на 10–20%."
  path="/blog/glonass-monitoring-rashody/"
  heading="Как ГЛОНАСС-мониторинг снижает транспортные расходы"
  category="Контроль"
  lead="Короткий ответ: мониторинг сам по себе не экономит деньги — экономят решения, принятые по его данным. Три источника экономии: холостые пробеги, оплаченные простои и поездки вне маршрутной программы. В среднем это 10–20% транспортного бюджета в первый год работы с данными."
  meta="Материал ОТК · 6 минут чтения"
  heroImg={img('/img/1482029255085-35a4a48b7084.jpg')}
  heroAlt="Навигация и мониторинг маршрута на экране в автомобиле"
  jsonLd={jsonLd}
>
  <h2>Что именно фиксирует система</h2>
  <p>Оборудование передаёт координаты автомобиля с интервалом в несколько секунд. На этой основе строятся производные показатели: фактический маршрут, пробег, время в движении и на стоянке, скоростной режим, время подачи и время окончания поездки. Данные хранятся и доступны в истории, поэтому спор о том, во сколько подали машину, решается за минуту.</p>

  <h2>Источник первый: холостые пробеги</h2>
  <p>Классическая картина — две машины едут в одном направлении с разницей в 20 минут, обе наполовину пустые. Наложение фактических треков за месяц показывает такие пересечения и позволяет собрать из них общий маршрут. В компаниях с распределёнными офисами объединение рейсов даёт наибольший эффект.</p>

  <h2>Источник второй: оплаченные простои</h2>
  <p>Если автомобиль закреплён на смену 12 часов, а полезная загрузка — 4 часа в день, компания оплачивает восемь часов ожидания. Данные мониторинга показывают распределение поездок по часам: часто вместо круглосуточного закрепления достаточно двух пиковых окон и такси на редкие поездки.</p>
  <div class="blueprint p-[clamp(24px,2.6vw,34px)] my-6">
    <div class="overflow-x-auto"><table class="table min-w-[440px]">
      <thead><tr><th>Что видно в данных</th><th>Какое решение</th><th>Типичный эффект</th></tr></thead>
      <tbody>
        {dataRows.map((r) => (<tr><td>{r[0]}</td><td>{r[1]}</td><td>{r[2]}</td></tr>))}
      </tbody>
    </table></div>
  </div>

  <h2>Источник третий: поездки вне программы</h2>
  <p>Речь не только о злоупотреблениях. Чаще это «серые» поездки по устной просьбе — они не проходят согласование, не попадают в отчёт и незаметно расширяют бюджет. Когда каждая поездка привязана к заявке и центру затрат, расходы становятся управляемыми.</p>

  <h2>С чего начать</h2>
  <ol>
    <li>Собрать данные за полный месяц — без выводов, просто накопить историю.</li>
    <li>Построить карту фактических маршрутов и найти пересечения.</li>
    <li>Посчитать долю полезного времени в оплаченных часах по каждому автомобилю.</li>
    <li>Проверить, какая часть поездок не привязана к заявке.</li>
    <li>Изменить формат по двум-трём самым «дорогим» автомобилям и через месяц сравнить.</li>
  </ol>
  <p>Важно: мониторинг — инструмент планирования, а не надзора за людьми. Его ценность в том, что решения о количестве машин и формате смен принимаются по фактическим данным, а не по ощущениям.</p>

  <div class="blueprint p-[clamp(30px,3vw,42px)] mt-9" style="background:color-mix(in srgb, var(--color-accent) 6%, var(--color-bg))">
    <h2 class="text-[26px] mt-0 mb-2.5">Разберём ваши маршруты</h2>
    <p class="m-0 mb-[18px] text-[15px] leading-[1.65] text-text/[0.78]">У клиентов ОТК ГЛОНАСС-мониторинг и отчётность по каждой поездке входят в обслуживание. Покажем на ваших данных, где теряются часы.</p>
    <div class="flex gap-3 flex-wrap">
      <a class="btn btn-primary min-h-[48px] tracking-[0.06em]" href="https://t.me/otktrans" target="_blank" rel="noopener">Написать в Telegram</a>
      <a class="btn btn-secondary min-h-[48px] tracking-[0.06em]" href="/uslugi/#tms">О платформе ОТК</a>
    </div>
  </div>
</ArticleLayout>
