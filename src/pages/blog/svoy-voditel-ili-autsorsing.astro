---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { img } from '../../lib/img';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Свой водитель или аутсорсинг: как посчитать реальную стоимость',
  description: 'Методика сравнения штатного водителя с автомобилем и корпоративного транспортного обслуживания по договору.',
  author: { '@type': 'Organization', name: 'ОТК' },
  publisher: { '@type': 'Organization', name: 'ОТК', logo: { '@type': 'ImageObject', url: 'https://otktrans.ru/logo.svg' } },
  mainEntityOfPage: 'https://otktrans.ru/blog/svoy-voditel-ili-autsorsing/',
  inLanguage: 'ru-RU',
});

const costItems = [
  'Оклад водителя и переработки',
  'Страховые взносы и НДФЛ',
  'Отпуска, больничные и подмена на это время',
  'Покупка или лизинг автомобиля',
  'Амортизация и потеря стоимости при продаже',
  'Плановое ТО, ремонты и шиномонтаж',
  'ОСАГО, КАСКО, налог на транспорт',
  'Топливо, мойка, парковка и платные дороги',
  'Предрейсовые медосмотры и путевые листы',
  'Простой автомобиля вне рабочих часов',
  'Административное время: кадры, закупки, контроль',
];

const compareRows = [
  ['Постоянные расходы', 'зарплата, налоги, автомобиль, страховки', 'нет'],
  ['Оплата простоя', 'оплачивается полностью', 'только заказанные часы'],
  ['Замена на время отпуска или болезни', 'ваша задача', 'входит в договор'],
  ['Ремонт и ТО', 'ваш бюджет и время', 'на стороне подрядчика'],
  ['Медконтроль и путевые листы', 'нужно организовать', 'входит в услугу'],
  ['Масштабирование', 'новый наём и покупка авто', 'заявка на дополнительный автомобиль'],
];

const questions = [
  'Что входит в ставку: топливо, мойка, платные дороги, переработки',
  'Как тарифицируются часы сверх смены и работа в выходные',
  'Сроки подмены автомобиля и водителя при поломке или болезни',
  'Как организован медконтроль и кто отвечает за путевые листы',
  'Какие отчётные документы приходят в конце месяца',
];
---
<ArticleLayout
  pageTitle="Свой водитель или аутсорсинг: как посчитать реальную стоимость — ОТК"
  description="Сравнение штатного водителя с автомобилем и корпоративного транспортного обслуживания: 11 статей затрат, скрытые расходы, риски простоя и методика расчёта стоимости часа поездки."
  path="/blog/svoy-voditel-ili-autsorsing/"
  heading="Свой водитель или аутсорсинг: как посчитать реальную стоимость"
  category="Главный материал"
  lead="Короткий ответ: сравнивать оклад водителя со ставкой подрядчика бессмысленно. Считать нужно полную стоимость владения — зарплату с налогами, автомобиль, его обслуживание, простои и замену на время отпуска."
  meta="Материал ОТК · 7 минут чтения"
  heroImg={img('/img/1635859890085-ec8cb5466806.jpg')}
  heroAlt="Специалист считает расходы, разложив документы на столе"
  jsonLd={jsonLd}
>
  <h2>Из чего складываются затраты на штатного водителя</h2>
  <p>Когда компания держит собственного водителя, в бюджете обычно видна одна строка — заработная плата. Фактических статей расходов больше, и большая часть из них проходит через другие подразделения: кадры, бухгалтерию, административно-хозяйственный отдел.</p>
  <ol>
    {costItems.map((item) => (<li>{item}</li>))}
  </ol>

  <h2>Как считать: стоимость часа фактической поездки</h2>
  <p>Сведите все годовые расходы в одну сумму и разделите её не на календарные часы, а на часы, когда автомобиль реально везёт сотрудников. Именно этот показатель сопоставим со ставкой подрядчика.</p>
  <div class="blueprint p-[clamp(24px,2.6vw,34px)] my-6">
    <div class="overflow-x-auto"><table class="table min-w-[440px]">
      <thead><tr><th>Показатель</th><th>Свой водитель</th><th>Обслуживание ОТК</th></tr></thead>
      <tbody>
        {compareRows.map((r) => (<tr><td>{r[0]}</td><td>{r[1]}</td><td>{r[2]}</td></tr>))}
      </tbody>
    </table></div>
  </div>

  <h2>Когда свой водитель всё-таки оправдан</h2>
  <p>Собственный штат имеет смысл при полной загрузке автомобиля 10–12 часов в день шесть дней в неделю, при особых требованиях к персоналу, которые нельзя передать подрядчику, и при наличии готовой инфраструктуры: гаража, механика, службы медконтроля. Во всех остальных случаях фиксированные расходы съедают экономию.</p>

  <h2>Что спросить у подрядчика перед сравнением</h2>
  <ul>
    {questions.map((item) => (<li>{item}</li>))}
  </ul>

  <div class="blueprint p-[clamp(30px,3vw,42px)] mt-9" style="background:color-mix(in srgb, var(--color-accent) 6%, var(--color-bg))">
    <h2 class="text-[26px] mt-0 mb-2.5">Посчитаем на ваших цифрах</h2>
    <p class="m-0 mb-[18px] text-[15px] leading-[1.65] text-text/[0.78]">Пришлите текущий состав парка и маршруты — вернёмся со сравнением стоимости и предложением по обслуживанию.</p>
    <div class="flex gap-3 flex-wrap">
      <a class="btn btn-primary min-h-[48px] tracking-[0.06em]" href="https://t.me/otktrans" target="_blank" rel="noopener">Telegram</a>
      <a class="btn btn-secondary min-h-[48px] tracking-[0.06em]" href="/kontakty/">Оставить заявку</a>
    </div>
  </div>
</ArticleLayout>
