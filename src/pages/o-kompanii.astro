---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import Corners from '../components/Corners.astro';

const stats = [
  { big: '10+', small: 'лет на рынке' },
  { big: '150+', small: 'сотрудников в штате' },
  { big: 'тысячи', small: 'маршрутов ежедневно' },
  { big: 'РФ', small: 'крупнейшие города страны' },
];

const team = [
  { name: 'Мурад Ханмамедов', role: 'Генеральный директор' },
  { name: 'Максим Язынин', role: 'Операционный директор' },
  { name: 'Светлана Бутова', role: 'Руководитель проектов развития' },
  { name: 'Екатерина Морякова', role: 'Менеджер по продажам проектов' },
  { name: 'Руслан Судзиловский', role: 'Старший менеджер по транспорту' },
  { name: 'Надежда Куликова', role: 'Старший логист' },
  { name: 'Елена Меньшикова', role: 'Логист' },
  { name: 'Григорий Михайлов', role: 'Механик по ремонту автомобилей' },
];

const tenderPoints = [
  'Участие в процедурах по 44-ФЗ и 223-ФЗ, коммерческих конкурсах и запросах предложений',
  'Договоры на 12, 24, 36 месяцев и более с фиксацией ставки',
  'Подготовка коммерческих предложений для обоснования НМЦК',
  'Рекомендательные письма и опыт исполнения аналогичных контрактов',
];

const tenderDocs = [
  'Учредительные документы и выписка ЕГРЮЛ',
  'Бухгалтерская отчётность и справка об отсутствии задолженности',
  'Полисы страхования парка и ответственности перевозчика',
  'Документы о лицензировании перевозок и медконтроле',
  'Рекомендательные письма действующих клиентов',
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'О компании ОТК',
  url: 'https://otktrans.ru/o-kompanii/',
  mainEntity: {
    '@type': 'Organization',
    name: 'ОТК',
    legalName: 'ООО «ОТК»',
    url: 'https://otktrans.ru/',
    numberOfEmployees: '150',
    foundingDate: '2015',
    areaServed: 'RU',
    employee: [
      { '@type': 'Person', name: 'Мурад Ханмамедов', jobTitle: 'Генеральный директор' },
      { '@type': 'Person', name: 'Максим Язынин', jobTitle: 'Операционный директор' },
    ],
  },
});
---
<BaseLayout
  title="О компании ОТК — корпоративные перевозки в Москве и регионах России"
  description="ОТК — транспортная компания для корпоративного рынка: более 10 лет на рынке, 150+ сотрудников в штате, тысячи маршрутов ежедневно. Миссия, команда, документы, работа по 44-ФЗ и 223-ФЗ."
  path="/o-kompanii/"
  active="about"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="border-b border-divider" style="background-image:linear-gradient(color-mix(in srgb, var(--color-text) 5%, transparent) 1px, transparent 1px),linear-gradient(90deg, color-mix(in srgb, var(--color-text) 5%, transparent) 1px, transparent 1px);background-size:64px 64px">
    <div class="max-w-container mx-auto px-[clamp(20px,4vw,56px)] py-[clamp(64px,8vw,112px)]">
      <div class="font-heading text-[12px] tracking-[0.14em] uppercase text-accent-700 mb-4">О компании</div>
      <h1 class="text-[clamp(36px,5vw,68px)] leading-[1.02] uppercase tracking-[-0.02em] m-0 mb-5 max-w-[20ch]">Транспортный подрядчик, которому передают весь автопарк</h1>
      <p class="text-[clamp(16px,1.3vw,19px)] leading-[1.6] max-w-[62ch] text-text/[0.78] m-0">ОТК работает на корпоративном рынке более 10 лет: перевозка сотрудников, багажа и корреспонденции в Москве, Московской области и крупнейших городах России. Мы учитываем деликатность корпоративных задач и обеспечиваем сервис с высоким уровнем безопасности и комфорта.</p>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-b border-divider">
    <div class="max-w-container mx-auto px-[clamp(20px,4vw,56px)]">
      <div class="grid grid-cols-[repeat(auto-fit,minmax(190px,1fr))]">
        {stats.map((s, i) => (
          <div class={`py-[clamp(28px,3vw,44px)] ${i === 0 ? 'pr-5 pl-0' : i === stats.length - 1 ? 'px-0 pl-5' : 'px-5'} ${i < stats.length - 1 ? 'border-r border-divider' : ''}`}>
            <div class="font-heading text-[clamp(36px,3.6vw,50px)] leading-none">{s.big}</div>
            <div class="text-[13px] tracking-[0.06em] uppercase text-text/[0.6] mt-2">{s.small}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Миссия -->
  <section class="border-b border-divider">
    <div class="max-w-container mx-auto px-[clamp(20px,4vw,56px)] py-[clamp(68px,8.5vw,120px)] grid grid-cols-[repeat(auto-fit,minmax(320px,1fr))] gap-[clamp(40px,4.6vw,84px)] items-start">
      <div>
        <h2 class="text-[clamp(26px,3vw,42px)] uppercase tracking-[-0.015em] m-0 mb-4">Миссия</h2>
        <p class="text-base leading-[1.65] max-w-[52ch] text-text/[0.78]">Помочь бизнесу решать сложные логистические вопросы без лишних временных и денежных затрат. Мы развиваем не только сервис, но и рабочие процессы: автоматизируем задачи, ускоряем документооборот и повышаем качество отчётности по поездкам.</p>
        <p class="text-base leading-[1.65] max-w-[52ch] text-text/[0.78]">ОТК превращает сложные логистические процессы в простые и понятные для любого клиента.</p>
      </div>
      <figure class="blueprint p-[clamp(32px,3.2vw,46px)] m-0" style="background:color-mix(in srgb, var(--color-accent) 6%, var(--color-bg))">
        <blockquote class="m-0 font-heading text-[clamp(22px,2.2vw,30px)] leading-[1.25]">«Соответствие нормам, высоким стандартам качества и пожеланиям заказчика — наши главные приоритеты. Именно так на ежедневной основе решаются логистические вопросы по перевозке сотрудников и корреспонденции».</blockquote>
        <figcaption class="mt-5 text-sm text-text/[0.65]"><strong class="font-heading text-[17px] text-text">Мурад Ханмамедов</strong><br />Генеральный директор ОТК</figcaption>
        <Corners />
      </figure>
    </div>
  </section>

  <!-- Команда -->
  <section class="border-b border-divider" style="background:color-mix(in srgb, var(--color-accent) 6%, var(--color-bg))">
    <div class="max-w-container mx-auto px-[clamp(20px,4vw,56px)] py-[clamp(68px,8.5vw,120px)]">
      <h2 class="text-[clamp(26px,3vw,42px)] uppercase tracking-[-0.015em] m-0 mb-7">Команда</h2>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(230px,1fr))] gap-px bg-bg border border-divider">
        {team.map((m) => (
          <div class="bg-bg outline outline-1 outline-divider p-[clamp(24px,2.6vw,34px)]">
            <div class="font-heading text-[20px] uppercase">{m.name}</div>
            <div class="text-[13px] text-accent-700 mt-1.5">{m.role}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Photo -->
  <section class="border-b border-divider">
    <div class="max-w-container mx-auto px-[clamp(20px,4vw,56px)] py-[clamp(44px,5vw,76px)]">
      <div class="blueprint h-[clamp(240px,30vw,420px)]">
        <img src="/img/1449965408869-eaa3f722e40d.jpg" alt="Руки водителя на руле во время поездки" loading="lazy" class="w-full h-full object-cover block" />
        <Corners />
      </div>
    </div>
  </section>

  <!-- Тендеры / Закупки -->
  <section id="tenders" class="border-b border-divider">
    <div class="max-w-container mx-auto px-[clamp(20px,4vw,56px)] py-[clamp(68px,8.5vw,120px)] grid grid-cols-[repeat(auto-fit,minmax(320px,1fr))] gap-[clamp(40px,4.6vw,84px)] items-start">
      <div>
        <span class="font-heading text-[12px] tracking-[0.14em] uppercase text-accent-700">Закупки</span>
        <h2 class="text-[clamp(26px,3vw,42px)] uppercase tracking-[-0.015em] mt-3 mb-4">Тендеры, 44-ФЗ и 223-ФЗ</h2>
        <p class="text-base leading-[1.65] max-w-[52ch] text-text/[0.78]">ОТК участвует в конкурсах и аукционах, работает с закупочными процедурами государственных и корпоративных заказчиков. Собственная юридическая служба готовит пакет документов и заключает договор в кратчайшие сроки.</p>
        <ul class="list-none p-0 mt-5 mb-0 flex flex-col gap-[11px]">
          {tenderPoints.map((li) => (
            <li class="grid grid-cols-[22px_1fr] gap-3 text-[15px]"><span class="text-accent">—</span><span>{li}</span></li>
          ))}
        </ul>
      </div>
      <div class="blueprint p-[clamp(28px,2.8vw,38px)]">
        <div class="font-heading text-[12px] tracking-[0.14em] uppercase text-text/[0.55] pb-3 border-b border-divider mb-3.5">Документы по запросу</div>
        <div class="overflow-x-auto"><table class="table min-w-[440px]">
          <tbody>
            {tenderDocs.map((d) => (
              <tr><td>{d}</td></tr>
            ))}
          </tbody>
        </table></div>
        <a class="btn btn-primary blueprint min-h-[48px] mt-[18px] tracking-[0.06em] uppercase" href="mailto:info@otktrans.ru?subject=Запрос%20документов%20для%20закупки">Запросить пакет документов<Corners /></a>
        <Corners />
      </div>
    </div>
  </section>
</BaseLayout>
