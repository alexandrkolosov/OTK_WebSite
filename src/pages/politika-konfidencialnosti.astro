          <li><b>Электронная почта:</b> <a href="mailto:info@otktrans.ru">info@otktrans.ru</a></li>
          <li><b>Телефон:</b> <a href="tel:+74957874095">+7 (495) 787-40-95</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
